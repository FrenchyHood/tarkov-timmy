{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarkov-timmy",
  "vars": {
    // "Download for Windows" serves the newest installer from this repo's latest GitHub release.
    "GITHUB_REPO": "FrenchyHood/tarkov-timmy"
  },
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /r/<room> URLs fall back to index.html; the app reads the room from the path.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RaidRoom" }]
  },
  // SQLite-backed Durable Objects are available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaidRoom"] }]
}
